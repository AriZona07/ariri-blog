rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Posts ─────────────────────────────────────────────
    // Lectura pública para todos; escritura solo para admin (custom claim)
    match /posts/{postId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;

      // ─── Comentarios (subcolección de cada post) ─────────
      // Lectura pública; creación para usuarios autenticados;
      // actualización de likes/replyCount para usuarios autenticados;
      // borrado para el autor o admin.
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.authorId == request.auth.uid;
        allow update: if request.auth != null;
        allow delete: if request.auth != null
          && (resource.data.authorId == request.auth.uid || request.auth.token.admin == true);

        // ─── Respuestas a comentarios (subcolección replies) ───
        match /replies/{replyId} {
          allow read: if true;
          allow create: if request.auth != null
            && request.resource.data.authorId == request.auth.uid;
          allow update: if request.auth != null;
          allow delete: if request.auth != null
            && (resource.data.authorId == request.auth.uid || request.auth.token.admin == true);
        }
      }
    }

    // ─── Libro de Visitas ───────────────────────────────────
    // Lectura pública; creación para usuarios autenticados
    match /guestbook/{entryId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid;
      allow delete: if request.auth != null
        && (resource.data.authorId == request.auth.uid || request.auth.token.admin == true);
    }

    // ─── Notificaciones ─────────────────────────────────────
    // Lectura pública/autenticada; creación por usuarios autenticados; borrado por admin/usuario
    match /notifications/{notificationId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // ─── Cola de Eliminaciones Programadas ───────────────────
    match /pending_deletions/{deletionId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && request.auth.token.admin == true;
    }

    // ─── Borradores (Drafts) ─────────────────────────────────
    match /drafts/{draftId} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }

    // ─── Preferencias de Usuario ────────────────────────────
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ─── Configuración Global del Sitio (Settings) ──────────
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
