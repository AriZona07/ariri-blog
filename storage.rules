rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ─── Avatares de Perfil de Usuarios ───────────────────
    // Lectura pública; cualquier usuario autenticado puede subir/modificar solo en su propia carpeta /avatars/{userId}/
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ─── Portadas de Posts ────────────────────────────────
    // Lectura pública; escritura permitida para usuarios autenticados (administradores)
    match /covers/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
